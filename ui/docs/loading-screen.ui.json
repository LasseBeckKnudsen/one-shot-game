      }
    }
  },
  "properties": {
    "progress": {
      "type": "number",
      "default": 0,
      "format": "value",
      "drivers": [
        {
          "type": "range",
          "min": 0,
          "max": 1,
          "empty": {
            "set": {
              "l_fill": {
                "fillAmount": 0
              }
            }
          },
          "full": {
            "set": {
              "l_fill": {
                "fillAmount": 1
              }
            }
          }
        },
        {
          "type": "smooth",
          "min": 160,
          "max": 420
        }
      ]
    },
    "tip": {
      "type": "text",
      "default": "Missing costs you a point."
    },
    "tipSwap": {
      "type": "trigger"
    }
  },
  "reactions": {
    "tipSwap": {
      "on": {
        "property": "tipSwap",
        "change": "trigger"
      },
      "set": {
        "root": {
          "scale": 1.1
        },
        "l_tippill": {
          "scale": 0.94,
          "opacity": 0.2
        }
      },
      "in": {
        "type": "easeOut",
        "ms": 90
      },
      "hold": 10,
      "back": {
        "type": "easeOut",
        "ms": 260
      }
    }
  },
  "transition": {
    "type": "easeOut",
    "ms": 350
  },
  "samples": {
    "mid": {
      "progress": 0.55,
      "tip": "Leaders lose half their score when hit."
    },
    "start": {
