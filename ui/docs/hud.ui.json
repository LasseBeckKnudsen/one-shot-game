  },
  "properties": {
    "score": {
      "type": "number",
      "default": 0,
      "format": "value"
    },
    "penalty": {
      "type": "number",
      "default": 1,
      "format": "value"
    },
    "timeText": {
      "type": "text",
      "default": "06:00"
    },
    "urgent": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "h_clocktxt": {
              "color": "#ff8f7aff"
            },
            "h_clock": {
              "tint": "#ff6a5aff",
              "tintAmount": 0.4
            }
          }
        }
      }
    },
    "banner": {
      "type": "text",
      "default": ""
    },
    "bannerSub": {
      "type": "text",
      "default": ""
    },
    "hint": {
      "type": "yesno",
      "default": true,
      "poses": {
        "yes": {
          "set": {
            "h_hint": {
              "hide": false
            }
          }
        }
      }
    },
    "cd": {
      "type": "number",
      "default": 0,
      "format": "value"
    },
    "ring": {
      "type": "number",
      "default": 1,
      "format": "value",
      "drivers": [
        {
          "type": "range",
          "min": 0,
          "max": 1,
          "empty": {
            "set": {
              "h_ring_fill": {
                "fillAmount": 0
              }
            }
          },
          "full": {
            "set": {
              "h_ring_fill": {
                "fillAmount": 1
              }
            }
          }
        }
      ]
    },
    "ready": {
      "type": "yesno",
      "default": true,
      "poses": {
        "yes": {
          "set": {
            "h_ring_arrow": {
              "hide": false
            },
            "h_ring_txt": {
              "hide": true
            },
            "h_lready": {
              "hide": false
            },
            "h_lname": {
              "hide": true
            }
          }
        },
        "no": {
          "set": {
            "h_lcharge": {
              "hide": false
            },
            "h_lname": {
              "color": "#cdbb98ff"
            },
            "h_launch": {
              "opacity": 0.92
            },
            "h_ring_bg": {
              "tint": "#3a1d0cf5"
            }
          }
        }
      }
    },
    "stone": {
      "type": "enum",
      "values": [
        "loaded",
        "flying",
        "gone"
      ],
      "default": "loaded",
      "poses": {
        "flying": {
          "set": {
            "h_stoneicon": {
              "opacity": 0.35
            },
            "h_loaded": {
              "hide": true
            },
            "h_reload": {
              "hide": false
            }
          }
        },
        "gone": {
          "set": {
            "h_stone": {
              "opacity": 0
            }
          }
        }
      }
    },
    "readyPulse": {
      "type": "trigger"
    },
    "bannerPop": {
      "type": "trigger"
    },
    "tone": {
      "type": "enum",
      "values": [
        "hit",
        "miss",
        "hurt",
        "over"
      ],
      "default": "hit",
      "poses": {
        "miss": {
          "set": {
            "h_banner": {
              "color": "#ffb066ff"
            }
          }
        },
        "hurt": {
          "set": {
            "h_banner": {
              "color": "#ff7a6eff"
            }
          }
        },
        "over": {
          "set": {
            "h_banner": {
              "color": "#ffe27aff"
            }
          }
        }
      }
    },
    "placeText": {
      "type": "text",
      "default": "1st / 1"
    },
    "first": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "h_star": {
              "tint": "#ffd23fff"
            },
            "h_placetxt": {
              "color": "#ffd23fff"
            }
          }
        }
      }
    },
    "board": {
      "type": "yesno",
      "default": false
    },
    "rows": {
      "type": "list",
      "of": "hud-row",
      "default": []
    },
    "toasts": {
      "type": "list",
      "of": "hud-toast",
      "default": []
    }
  },
  "reactions": {
    "readyPulse": {
      "on": {
        "property": "readyPulse",
        "change": "trigger"
      },
      "set": {
        "root": {
          "scale": 1.1
        },
        "h_launch": {
          "scale": 1.16
        }
      },
      "in": {
        "type": "easeOut",
        "ms": 110
      },
      "hold": 120,
      "back": {
        "type": "elastic",
        "ms": 520,
        "amplitude": 1.2,
        "period": 0.3
      }
    },
    "bannerPop": {
      "on": {
        "property": "bannerPop",
        "change": "trigger"
      },
      "set": {
        "root": {
          "scale": 1.1
        },
        "h_banners": {
          "scale": 1.22
        }
      },
      "in": {
        "type": "easeOut",
        "ms": 90
      },
      "hold": 80,
      "back": {
        "type": "elastic",
        "ms": 480,
        "amplitude": 1.1,
        "period": 0.3
      }
    },
    "scoreUp": {
      "on": {
        "property": "score",
        "change": "up",
        "when": "now"
      },
      "set": {
        "root": {
          "scale": 1.1
        },
        "h_score": {
          "scale": 1.16
        }
      },
      "in": {
        "type": "easeOut",
        "ms": 90
      },
      "hold": 90,
      "back": {
        "type": "elastic",
        "ms": 420,
        "amplitude": 1.2,
        "period": 0.3
      }
    }
  },
  "samples": {
    "play": {
      "score": 3,
      "penalty": 2,
      "timeText": "02:34",
